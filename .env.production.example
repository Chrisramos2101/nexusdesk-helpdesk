# NexusDesk production configuration example
# Copy values into your deployment platform. Never commit real secrets.

FLASK_ENV=production
TRUST_PROXY_HEADERS=True
LOG_TO_STDOUT=True

SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=postgresql://username:password@host:5432/database_name

APP_BASE_URL=https://your-production-domain.example

UPLOAD_FOLDER=/tmp/nexusdesk/uploads
MAX_UPLOAD_MB=10

# Cloud transactional email (preferred)
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=NexusDesk

# Optional one-time portfolio admin bootstrap.
# Remove or rotate sensitive bootstrap values after initial provisioning.
BOOTSTRAP_ADMIN_USERNAME=portfolio_admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_private_password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Portfolio Admin
BOOTSTRAP_ADMIN_DEPARTMENT=IT

# Optional synthetic demo population.
SEED_DEMO_DATA=false

# Local SMTP fallback (optional; not required when Brevo is configured).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=sender@example.com
MAIL_PASSWORD=replace_with_app_password
MAIL_DEFAULT_SENDER=NexusDesk <sender@example.com>
